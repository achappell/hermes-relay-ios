{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_PROJECT_DIR:-$PWD}/.bmad-loop/bmad_loop_hook.py\" SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_PROJECT_DIR:-$PWD}/.bmad-loop/bmad_loop_hook.py\" Stop"
          }
        ]
      }
    ]
  }
}
